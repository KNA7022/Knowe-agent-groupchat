+        res.resume();
+        rejectPromise(new Error('Active credential settings are unavailable.'));
+        return;
+      }
+      const chunks: Buffer[] = [];
+      let size = 0;
+      res.on('data', (chunk: Buffer) => {
+        size += chunk.length;
+        if (size > 1_048_576) {
+          req.destroy();
+          return;
+        }
+        chunks.push(chunk);
+      });
+      res.once('end', () => {
